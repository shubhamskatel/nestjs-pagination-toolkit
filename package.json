{
  "name": "nestjs-pagination-toolkit",
  "version": "0.1.1",
  "description": "Reusable pagination, dynamic filtering, sorting and search helper for NestJS + TypeORM repositories",
  "keywords": [
    "nestjs",
    "typeorm",
    "pagination",
    "filtering",
    "sorting",
    "search",
    "typescript"
  ],
  "license": "MIT",
  "author": "Shubham Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamskatel/nestjs-pagination-toolkit.git"
  },
  "homepage": "https://github.com/shubhamskatel/nestjs-pagination-toolkit#readme",
  "bugs": {
    "url": "https://github.com/shubhamskatel/nestjs-pagination-toolkit/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "smoke:mysql": "ts-node -T --compiler-options \"{\\\"module\\\":\\\"commonjs\\\",\\\"experimentalDecorators\\\":true,\\\"emitDecoratorMetadata\\\":true}\" smoke-test/run.ts",
    "smoke:postgres": "ts-node -T --compiler-options \"{\\\"module\\\":\\\"commonjs\\\",\\\"experimentalDecorators\\\":true,\\\"emitDecoratorMetadata\\\":true}\" smoke-test/run-pg.ts",
    "test:e2e": "jest --config jest-e2e.config.json"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0 || ^0.15.0",
    "typeorm": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/testing": "^11.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jest": "^30.0.0",
    "mysql2": "^3.23.4",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.27",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
